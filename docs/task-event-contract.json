{
  "description": "Shared notification-phase contract for the Android TaskReducer and the companion mapEvent. For each case both implementations must yield the same resulting phase. 'expectedPhase' is the phase after applying the event; a no-op transition is normalized to the previous phase (or IDLE when there was none).",
  "phases": ["IDLE", "THINKING", "TOOL", "SUBAGENT", "TESTING", "WAITING_PERMISSION", "WAITING_QUESTION", "COMPLETED", "FAILED", "ABORTED", "DISCONNECTED"],
  "cases": [
    { "name": "permission asked moves to waiting",
      "companion": { "type": "permission.asked" },
      "kotlin": { "type": "permission.asked", "properties": { "sessionID": "s" } },
      "previous": null, "expectedPhase": "WAITING_PERMISSION" },
    { "name": "question asked moves to waiting",
      "companion": { "type": "question.asked" },
      "kotlin": { "type": "question.asked", "properties": { "sessionID": "s" } },
      "previous": null, "expectedPhase": "WAITING_QUESTION" },
    { "name": "permission reply resumes thinking",
      "companion": { "type": "permission.replied" },
      "kotlin": { "type": "permission.replied", "properties": { "sessionID": "s" } },
      "previous": "WAITING_PERMISSION", "expectedPhase": "THINKING" },
    { "name": "busy status starts thinking",
      "companion": { "type": "session.status", "status": "busy" },
      "kotlin": { "type": "session.status", "properties": { "sessionID": "s", "status": { "type": "busy" } } },
      "previous": null, "expectedPhase": "THINKING" },
    { "name": "idle status after activity completes",
      "companion": { "type": "session.status", "status": "idle" },
      "kotlin": { "type": "session.status", "properties": { "sessionID": "s", "status": { "type": "idle" } } },
      "previous": "THINKING", "expectedPhase": "COMPLETED" },
    { "name": "idle event after activity completes",
      "companion": { "type": "session.idle" },
      "kotlin": { "type": "session.idle", "properties": { "sessionID": "s" } },
      "previous": "THINKING", "expectedPhase": "COMPLETED" },
    { "name": "idle without prior activity is a no-op",
      "companion": { "type": "session.idle" },
      "kotlin": { "type": "session.idle", "properties": { "sessionID": "s" } },
      "previous": null, "expectedPhase": "IDLE" },
    { "name": "repeated idle after completion is a no-op",
      "companion": { "type": "session.idle" },
      "kotlin": { "type": "session.idle", "properties": { "sessionID": "s" } },
      "previous": "COMPLETED", "expectedPhase": "COMPLETED" },
    { "name": "session error fails",
      "companion": { "type": "session.error" },
      "kotlin": { "type": "session.error", "properties": { "sessionID": "s" } },
      "previous": "THINKING", "expectedPhase": "FAILED" },
    { "name": "session abort stops",
      "companion": { "type": "session.aborted" },
      "kotlin": { "type": "session.aborted", "properties": { "sessionID": "s" } },
      "previous": "THINKING", "expectedPhase": "ABORTED" },
    { "name": "reasoning part stays thinking",
      "companion": { "type": "message.part.updated", "partType": "reasoning", "tool": null },
      "kotlin": { "type": "message.part.updated", "properties": { "sessionID": "s", "part": { "type": "reasoning" } } },
      "previous": "THINKING", "expectedPhase": "THINKING" },
    { "name": "plain tool part is a tool step",
      "companion": { "type": "message.part.updated", "partType": "tool", "tool": "grep" },
      "kotlin": { "type": "message.part.updated", "properties": { "sessionID": "s", "part": { "type": "tool", "tool": "grep" } } },
      "previous": "THINKING", "expectedPhase": "TOOL" },
    { "name": "bash running a test command is testing",
      "companion": { "type": "message.part.updated", "partType": "tool", "tool": "bash", "toolKind": "TESTING" },
      "kotlin": { "type": "message.part.updated", "properties": { "sessionID": "s", "part": { "type": "tool", "tool": "bash", "state": { "input": { "command": "gradle test" } } } } },
      "previous": "THINKING", "expectedPhase": "TESTING" },
    { "name": "v2 tool part uses its name as the tool category",
      "companion": { "type": "message.part.updated", "partType": "tool", "tool": "task", "toolKind": "SUBAGENT" },
      "kotlin": { "type": "message.part.updated", "properties": { "sessionID": "s", "part": { "type": "tool", "name": "task" } } },
      "previous": "THINKING", "expectedPhase": "SUBAGENT" },
    { "name": "task tool is a subagent",
      "companion": { "type": "message.part.updated", "partType": "tool", "tool": "task", "toolKind": "SUBAGENT" },
      "kotlin": { "type": "message.part.updated", "properties": { "sessionID": "s", "part": { "type": "tool", "tool": "task" } } },
      "previous": "THINKING", "expectedPhase": "SUBAGENT" }
  ]
}
